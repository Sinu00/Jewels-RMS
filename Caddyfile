# Caddy reverse proxy for the single-instance deploy (AWS Lightsail).
# Place at /etc/caddy/Caddyfile, then: sudo systemctl reload caddy
# Caddy auto-provisions + renews HTTPS (Let's Encrypt) for this domain.
#
# /api/*     and /uploads/*  -> Express API on :3001  (JSON + item photos)
# everything else            -> Next.js on :3000      (the app UI)
#
# Routing /api and /uploads directly to the API means item-photo URLs
# (BASE_URL=https://jewels.rivaazbridal.in/uploads/...) resolve through Caddy,
# and the Next /api rewrite is never hit in production.

jewels.rivaazbridal.in {
	encode gzip zstd

	# Cache uploaded item photos aggressively
	@uploads path /uploads/*
	header @uploads Cache-Control "public, max-age=2592000"

	handle /api/* {
		reverse_proxy localhost:3001
	}

	handle /uploads/* {
		reverse_proxy localhost:3001
	}

	handle {
		reverse_proxy localhost:3000
	}
}
