# Copy to apps/api/.env on the server and fill in real values.
# Generate a secret with:  openssl rand -hex 32

DATABASE_URL=postgresql://rental:CHANGE_ME@localhost:5432/rental_db
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
PORT=3001
NODE_ENV=production

# Absolute path to where uploaded item photos live (back this up!).
# Point at a DO Block Storage mount if you outgrow the OS disk.
UPLOAD_DIR=/home/deploy/app/uploads

# Public base used to build image URLs — MUST be the live domain over https,
# or every item photo 404s.
BASE_URL=https://jewels.rivaazbridal.in

# Browser origin allowed by CORS (same domain; same-origin so rarely hit).
CORS_ORIGIN=https://jewels.rivaazbridal.in
