generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Outlet {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  ornaments Ornament[]
  customers Customer[]
  rentals   Rental[]
  payments  Payment[]

  @@map("outlets")
}

model User {
  id           String   @id @default(cuid())
  outletId     String
  outlet       Outlet   @relation(fields: [outletId], references: [id])
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments Payment[]

  @@index([outletId])
  @@map("users")
}

enum UserRole {
  ADMIN
  STAFF
}

model Ornament {
  id             String   @id @default(cuid())
  outletId       String
  outlet         Outlet   @relation(fields: [outletId], references: [id])
  itemCode       String   @unique
  name           String
  category       String
  weightGrams    Decimal? @db.Decimal(8, 2)
  baseRatePerDay Decimal  @db.Decimal(10, 2)
  valuationPrice Decimal  @db.Decimal(12, 2)
  description    String?
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  images      OrnamentImage[]
  rentalItems RentalItem[]

  @@index([outletId, isDeleted])
  @@index([outletId, category])
  @@map("ornaments")
}

model OrnamentImage {
  id           String   @id @default(cuid())
  ornamentId   String
  ornament     Ornament @relation(fields: [ornamentId], references: [id])
  filePath     String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([ornamentId])
  @@map("ornament_images")
}

model Customer {
  id            String   @id @default(cuid())
  outletId      String
  outlet        Outlet   @relation(fields: [outletId], references: [id])
  name          String
  phone         String
  address       String?
  idProofType   String?
  idProofNumber String?
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rentals Rental[]

  @@index([outletId, isDeleted])
  @@index([outletId, phone])
  @@map("customers")
}

model Rental {
  id              String       @id @default(cuid())
  rentalNumber    String       @unique
  outletId        String
  outlet          Outlet       @relation(fields: [outletId], references: [id])
  customerId      String
  customer        Customer     @relation(fields: [customerId], references: [id])
  status          RentalStatus @default(ACTIVE)
  startDate       DateTime     @db.Date
  dueDate         DateTime     @db.Date
  returnedAt      DateTime?
  depositAmount   Decimal      @db.Decimal(10, 2)
  depositRefunded Boolean      @default(false)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items      RentalItem[]
  extensions RentalExtension[]
  payments   Payment[]

  @@index([outletId, status])
  @@index([outletId, customerId])
  @@index([outletId, dueDate])
  @@map("rentals")
}

enum RentalStatus {
  ACTIVE
  OVERDUE
  EXTENDED
  RETURNED
}

model RentalItem {
  id         String   @id @default(cuid())
  rentalId   String
  rental     Rental   @relation(fields: [rentalId], references: [id])
  ornamentId String
  ornament   Ornament @relation(fields: [ornamentId], references: [id])
  ratePerDay Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  @@index([rentalId])
  @@index([ornamentId])
  @@map("rental_items")
}

model RentalExtension {
  id              String   @id @default(cuid())
  rentalId        String
  rental          Rental   @relation(fields: [rentalId], references: [id])
  previousDueDate DateTime @db.Date
  newDueDate      DateTime @db.Date
  reason          String?
  createdAt       DateTime @default(now())

  @@index([rentalId])
  @@map("rental_extensions")
}

model Payment {
  id           String        @id @default(cuid())
  outletId     String
  outlet       Outlet        @relation(fields: [outletId], references: [id])
  rentalId     String?
  rental       Rental?       @relation(fields: [rentalId], references: [id])
  recordedById String
  recordedBy   User          @relation(fields: [recordedById], references: [id])
  type         PaymentType
  method       PaymentMethod
  amount       Decimal       @db.Decimal(10, 2)
  note         String?
  createdAt    DateTime      @default(now())

  @@index([outletId, createdAt])
  @@index([outletId, type])
  @@index([rentalId])
  @@map("payments")
}

enum PaymentType {
  RENTAL
  DEPOSIT
  DEPOSIT_REFUND
  OTHER
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
}

model ItemCodeSequence {
  id       String @id @default(cuid())
  prefix   String
  outletId String
  lastSeq  Int    @default(0)

  @@unique([prefix, outletId])
  @@map("item_code_sequences")
}
