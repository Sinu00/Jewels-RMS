{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@rental/types": ["../../packages/types/src/index.ts"]
    }
  },
  "include": ["src"],
  // Tests are run by Vitest, never compiled into dist/ — and they use ESM
  // syntax the CommonJS build target rejects. Keep them out of `pnpm build`.
  "exclude": ["node_modules", "dist", "**/__tests__", "**/*.test.ts"]
}
